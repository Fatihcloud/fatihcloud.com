---
import { withCache } from "../lib/cache";

const GITLAB_TOKEN = import.meta.env.GITLAB_TOKEN;
const GITLAB_USERNAME = import.meta.env.GITLAB_USERNAME;

let activityData: { dates: Record<string, number>, total: number } | null = null;
let error: string | null = null;

if (GITLAB_TOKEN && GITLAB_USERNAME) {
  try {
    activityData = await withCache('gitlab-activity', 86400, async () => {
      // 1. Get User ID
      const userRes = await fetch(`https://gitlab.com/api/v4/users?username=${GITLAB_USERNAME}`, {
        headers: { 'PRIVATE-TOKEN': GITLAB_TOKEN }
      });
      if (!userRes.ok) throw new Error(`GitLab API user fetch error: ${userRes.status}`);
      const users = await userRes.json();
      if (!users || users.length === 0) throw new Error(`GitLab user ${GITLAB_USERNAME} not found`);
      const userId = users[0].id;

      // 2. Fetch Events
      let page = 1;
      let hasMore = true;
      const oneYearAgoDate = new Date();
      oneYearAgoDate.setFullYear(oneYearAgoDate.getFullYear() - 1);
      const afterDate = oneYearAgoDate.toISOString().split('T')[0];
      
      const dates: Record<string, number> = {};
      let totalContributions = 0;

      while (hasMore && page <= 20) { // Safety limit: max 20 pages (2000 events)
        const url = `https://gitlab.com/api/v4/users/${userId}/events?per_page=100&page=${page}&after=${afterDate}`;
        const eventsRes = await fetch(url, {
          headers: { 'PRIVATE-TOKEN': GITLAB_TOKEN }
        });

        if (!eventsRes.ok) throw new Error(`GitLab API events fetch error: ${eventsRes.status}`);
        const events = await eventsRes.json();

        // Increment count for each event based on its created_at date
        events.forEach((event: any) => {
          if (event.created_at) {
            const dateStr = event.created_at.split('T')[0];
            dates[dateStr] = (dates[dateStr] || 0) + 1;
            totalContributions++;
          }
        });

        if (events.length < 100) {
          hasMore = false;
        } else {
          page++;
        }
      }

      return { dates, total: totalContributions };
    });
  } catch (err: any) {
    console.error("GitlabActivity error:", err);
    error = err.message;
  }
}

// Generate the last 365 days grouped by weeks for rendering exactly like GitHub
function generateWeeksData(countsMap: Record<string, number>) {
  const weeks: { contributionDays: { date: string, contributionCount: number }[] }[] = [];
  const today = new Date();
  
  // Find the sunday before 364 days ago
  const startDay = new Date(today);
  startDay.setDate(today.getDate() - 364);
  while (startDay.getDay() !== 0) {
    startDay.setDate(startDay.getDate() - 1);
  }

  let currentDay = new Date(startDay);
  
  for (let w = 0; w < 53; w++) {
    const week = { contributionDays: [] as { date: string, contributionCount: number }[] };
    for (let d = 0; d < 7; d++) {
      if (currentDay > today) break;

      const dateStr = currentDay.toISOString().split('T')[0];
      week.contributionDays.push({
        date: dateStr,
        contributionCount: countsMap[dateStr] || 0
      });
      
      currentDay.setDate(currentDay.getDate() + 1);
    }
    if (week.contributionDays.length > 0) {
      weeks.push(week);
    }
  }

  return weeks;
}

const totalContributions = activityData?.total || 0;
const weeks = activityData ? generateWeeksData(activityData.dates) : [];

function getColorClass(count: number) {
  if (count === 0) return 'bg-neutral-200 dark:bg-neutral-800/50';
  if (count <= 2) return 'bg-orange-200 dark:bg-orange-900/60';
  if (count <= 4) return 'bg-orange-300 dark:bg-orange-700/60';
  if (count <= 6) return 'bg-orange-400 dark:bg-orange-500/80';
  return 'bg-orange-500 dark:bg-orange-400';
}
---

<div class="space-y-4">
  <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-2">
      <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current text-[#FC6D26]" aria-hidden="true"><path d="M22.65 14.39L12 22.13 1.35 14.39a.84.84 0 0 1-.3-.94l1.22-3.78 2.44-7.51A.84.84 0 0 1 6.3 1.8l3.09 9.52h5.22l3.09-9.52a.84.84 0 0 1 1.59.36l2.44 7.51 1.22 3.78a.84.84 0 0 1-.3.94z"></path></svg>
      <span class="font-semibold text-black dark:text-white">GitLab Contributions</span>
    </div>
    <span class="text-sm opacity-75 pl-7 sm:pl-0">{totalContributions} contributions in the last year</span>
  </div>

  {error && <p class="text-sm text-red-500">Could not load GitLab activity: {error}</p>}
  
  {!error && weeks.length > 0 && (
    <div class="relative w-full overflow-x-auto [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none] gitlab-activity-scroll">
      <div class="inline-flex gap-[3px]">
        {weeks.map((week: any) => (
          <div class="flex flex-col gap-[3px]">
            {week.contributionDays.map((day: any) => (
              <div
                class={`w-[11px] h-[11px] rounded-[2px] ${getColorClass(day.contributionCount)}`}
                title={`${day.contributionCount} contributions on ${day.date}`}
              ></div>
            ))}
          </div>
        ))}
      </div>
    </div>
    <script>
      document.querySelectorAll('.gitlab-activity-scroll').forEach(el => {
        el.scrollLeft = el.scrollWidth;
      });
    </script>
  )}
</div>
