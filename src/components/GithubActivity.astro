---
import { withCache } from "../lib/cache";

const GITHUB_TOKEN = import.meta.env.GH_TOKEN;
const GITHUB_USERNAME = import.meta.env.GH_USER;

let activityData: any = null;
let error: string | null = null;

if (GITHUB_TOKEN && GITHUB_USERNAME) {
  try {
    activityData = await withCache('github-activity', 86400, async () => {
      const response = await fetch('https://api.github.com/graphql', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${GITHUB_TOKEN}`,
        },
        body: JSON.stringify({
          query: `
            query($userName:String!) {
              user(login: $userName){
                contributionsCollection {
                  contributionCalendar {
                    totalContributions
                    weeks {
                      contributionDays {
                        contributionCount
                        date
                      }
                    }
                  }
                }
              }
            }
          `,
          variables: {
            userName: GITHUB_USERNAME
          }
        })
      });

      if (!response.ok) {
        throw new Error(`GitHub API error: ${response.status} ${response.statusText}`);
      }

      const json = await response.json();
      if (json.errors) {
        throw new Error(`GitHub GraphQL error: ${json.errors[0].message}`);
      }
      
      return json.data.user.contributionsCollection.contributionCalendar;
    });
  } catch (err: any) {
    console.error("GithubActivity error:", err);
    error = err.message;
  }
}

const totalContributions = activityData?.totalContributions || 0;
const weeks = activityData?.weeks || [];

function getColorClass(count: number) {
  if (count === 0) return 'bg-neutral-200 dark:bg-neutral-800/50';
  if (count <= 3) return 'bg-emerald-200 dark:bg-emerald-900/60';
  if (count <= 6) return 'bg-emerald-300 dark:bg-emerald-700/60';
  if (count <= 9) return 'bg-emerald-400 dark:bg-emerald-500/80';
  return 'bg-emerald-500 dark:bg-emerald-400';
}
---

<div class="space-y-4">
  <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-2">
      <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current text-black dark:text-white" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.113.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"></path></svg>
      <span class="font-semibold text-black dark:text-white">GitHub Contributions</span>
    </div>
    <span class="text-sm opacity-75 pl-7 sm:pl-0">{totalContributions} contributions in the last year</span>
  </div>

  {error && <p class="text-sm text-red-500">Could not load GitHub activity: {error}</p>}
  
  {!error && weeks.length > 0 && (
    <div class="relative w-full overflow-x-auto [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none] github-activity-scroll">
      <div class="inline-flex gap-[3px]">
        {weeks.map((week: any) => (
          <div class="flex flex-col gap-[3px]">
            {week.contributionDays.map((day: any) => (
              <div
                class={`w-[11px] h-[11px] rounded-[2px] ${getColorClass(day.contributionCount)}`}
                title={`${day.contributionCount} contributions on ${day.date}`}
              ></div>
            ))}
          </div>
        ))}
      </div>
    </div>
    <script>
      document.querySelectorAll('.github-activity-scroll').forEach(el => {
        el.scrollLeft = el.scrollWidth;
      });
    </script>
  )}
</div>
